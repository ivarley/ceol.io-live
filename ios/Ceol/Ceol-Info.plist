<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen: the wordmark on black, where SplashView then draws it at the
	     same size and place and adds the tagline, so launch doesn't jump. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<!-- Recording a night (spec 053, NightRecorder): the microphone, and the audio
	     background mode so it keeps recording with the screen locked or while the rest
	     of the app is in use. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Ceol records the session to work out which tunes are being played, and keeps the recording on this phone.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
