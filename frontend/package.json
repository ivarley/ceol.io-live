{
  "name": "ceol-live-logging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Spec 024 live-logging screen — clean-slate Svelte + Vite bundle, served by Flask under /static/live.",
  "scripts": {
    "dev": "vite build --watch",
    "dev:mytunes": "vite build --watch --config vite.mytunes.config.js",
    "dev:mytunespage": "vite build --watch --config vite.mytunespage.config.js",
    "dev:tunesheet": "vite build --watch --config vite.tunesheet.config.js",
    "dev:sessionsdir": "vite build --watch --config vite.sessionsdir.config.js",
    "dev:sessionpage": "vite build --watch --config vite.sessionpage.config.js",
    "dev:personpage": "vite build --watch --config vite.personpage.config.js",
    "dev:sessionadminpage": "vite build --watch --config vite.sessionadminpage.config.js",
    "build": "vite build && vite build --config vite.mytunes.config.js && vite build --config vite.mytunespage.config.js && vite build --config vite.tunesheet.config.js && vite build --config vite.sessionsdir.config.js && vite build --config vite.sessionpage.config.js && vite build --config vite.personpage.config.js && vite build --config vite.sessionadminpage.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/svelte": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.56.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "bits-ui": "^2.18.1"
  }
}
