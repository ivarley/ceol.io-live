{
  "_readme": [
    "Who's there, in the live logger (spec 024 §F, spec 034): the loggers' colours",
    "(PALETTE, by the persisted per-session index a roster entry carries as arrival_seq",
    "and a record as logged_by_color), initials for the header avatars, whose colour a",
    "logged tune carries (only someone else's), who else is typing, and how the",
    "attendance picker groups a session's people (people rows from",
    "/api/live/instances/{id}/people, in the server's order)."
  ],
  "constants": {
    "PALETTE": [
      "#4f9dff",
      "#46d27a",
      "#ef8b3d",
      "#e0594b",
      "#b07cff",
      "#3fd0c9",
      "#ff8fab",
      "#9ab0c0"
    ],
    "MAX_ACTIVITY": 3
  },
  "functions": {
    "colorFor": {
      "params": [
        "seq"
      ],
      "cases": [
        {
          "name": "the first",
          "input": {
            "seq": 0
          },
          "expected": "#4f9dff"
        },
        {
          "name": "the last",
          "input": {
            "seq": 7
          },
          "expected": "#9ab0c0"
        },
        {
          "name": "wraps past the end",
          "input": {
            "seq": 9
          },
          "expected": "#46d27a"
        },
        {
          "name": "a negative index wraps too",
          "input": {
            "seq": -1
          },
          "expected": "#9ab0c0"
        }
      ]
    },
    "initials": {
      "params": [
        "name"
      ],
      "cases": [
        {
          "name": "first and last",
          "input": {
            "name": "Sarah O'Connor"
          },
          "expected": "SO"
        },
        {
          "name": "first and last of several",
          "input": {
            "name": "Mary Kate  Quinn"
          },
          "expected": "MQ"
        },
        {
          "name": "one word: two letters",
          "input": {
            "name": "ian"
          },
          "expected": "IA"
        },
        {
          "name": "one letter",
          "input": {
            "name": "Q"
          },
          "expected": "Q"
        },
        {
          "name": "nothing",
          "input": {
            "name": "  "
          },
          "expected": "?"
        },
        {
          "name": "null",
          "input": {
            "name": null
          },
          "expected": "?"
        },
        {
          "name": "accented",
          "input": {
            "name": "Éamonn Ó Súilleabháin"
          },
          "expected": "ÉS"
        }
      ]
    },
    "loggerColorIdx": {
      "params": [
        "r",
        "myPersonId",
        "roster"
      ],
      "cases": [
        {
          "name": "my own row: none",
          "input": {
            "r": {
              "logged_by_person_id": 1,
              "logged_by_color": 2
            },
            "myPersonId": 1,
            "roster": [
              {
                "person_id": 5,
                "arrival_seq": 3
              },
              {
                "person_id": 6,
                "arrival_seq": 1
              }
            ]
          },
          "expected": null
        },
        {
          "name": "someone else's: their saved colour",
          "input": {
            "r": {
              "logged_by_person_id": 5,
              "logged_by_color": 2
            },
            "myPersonId": 1,
            "roster": [
              {
                "person_id": 5,
                "arrival_seq": 3
              },
              {
                "person_id": 6,
                "arrival_seq": 1
              }
            ]
          },
          "expected": 2
        },
        {
          "name": "no saved colour: the roster's",
          "input": {
            "r": {
              "logged_by_person_id": 6,
              "logged_by_color": null
            },
            "myPersonId": 1,
            "roster": [
              {
                "person_id": 5,
                "arrival_seq": 3
              },
              {
                "person_id": 6,
                "arrival_seq": 1
              }
            ]
          },
          "expected": 1
        },
        {
          "name": "not on the roster either: none",
          "input": {
            "r": {
              "logged_by_person_id": 9,
              "logged_by_color": null
            },
            "myPersonId": 1,
            "roster": [
              {
                "person_id": 5,
                "arrival_seq": 3
              },
              {
                "person_id": 6,
                "arrival_seq": 1
              }
            ]
          },
          "expected": null
        },
        {
          "name": "a colour 0 counts",
          "input": {
            "r": {
              "logged_by_person_id": 5,
              "logged_by_color": 0
            },
            "myPersonId": 1,
            "roster": [
              {
                "person_id": 5,
                "arrival_seq": 3
              },
              {
                "person_id": 6,
                "arrival_seq": 1
              }
            ]
          },
          "expected": 0
        },
        {
          "name": "nobody known",
          "input": {
            "r": {},
            "myPersonId": 1
          },
          "expected": null
        },
        {
          "name": "signed out (no me)",
          "input": {
            "r": {
              "logged_by_person_id": 1,
              "logged_by_color": 4
            },
            "myPersonId": null,
            "roster": []
          },
          "expected": 4
        }
      ]
    },
    "othersTyping": {
      "params": [
        "typers",
        "myPersonId"
      ],
      "cases": [
        {
          "name": "everyone but me",
          "input": {
            "typers": [
              {
                "person_id": 1,
                "name": "Ian Varley",
                "arrival_seq": 0
              },
              {
                "person_id": 5,
                "name": "Sarah O",
                "arrival_seq": 3
              }
            ],
            "myPersonId": 1
          },
          "expected": [
            {
              "person_id": 5,
              "name": "Sarah O",
              "arrival_seq": 3
            }
          ]
        },
        {
          "name": "just me",
          "input": {
            "typers": [
              {
                "person_id": 1,
                "name": "Ian Varley",
                "arrival_seq": 0
              }
            ],
            "myPersonId": 1
          },
          "expected": []
        },
        {
          "name": "nobody",
          "input": {
            "typers": null,
            "myPersonId": 1
          },
          "expected": []
        }
      ]
    },
    "pickerTiers": {
      "params": [
        "people",
        "query"
      ],
      "cases": [
        {
          "name": "checked in (archived or not), the rest, archived hidden",
          "input": {
            "people": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              },
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              },
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              },
              {
                "person_id": 4,
                "display_name": "Seán Kelly",
                "attending": false,
                "archived": true
              },
              {
                "person_id": 5,
                "display_name": "Tom Byrne",
                "attending": false,
                "archived": false
              }
            ],
            "query": ""
          },
          "expected": {
            "here": [
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              },
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              }
            ],
            "roster": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              },
              {
                "person_id": 5,
                "display_name": "Tom Byrne",
                "attending": false,
                "archived": false
              }
            ],
            "archived": []
          }
        },
        {
          "name": "a search finds the archived too",
          "input": {
            "people": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              },
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              },
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              },
              {
                "person_id": 4,
                "display_name": "Seán Kelly",
                "attending": false,
                "archived": true
              },
              {
                "person_id": 5,
                "display_name": "Tom Byrne",
                "attending": false,
                "archived": false
              }
            ],
            "query": "kelly"
          },
          "expected": {
            "here": [
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              }
            ],
            "roster": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              }
            ],
            "archived": [
              {
                "person_id": 4,
                "display_name": "Seán Kelly",
                "attending": false,
                "archived": true
              }
            ]
          }
        },
        {
          "name": "case-insensitive, trimmed",
          "input": {
            "people": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              },
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              },
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              },
              {
                "person_id": 4,
                "display_name": "Seán Kelly",
                "attending": false,
                "archived": true
              },
              {
                "person_id": 5,
                "display_name": "Tom Byrne",
                "attending": false,
                "archived": false
              }
            ],
            "query": "  NOLAN "
          },
          "expected": {
            "here": [
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              }
            ],
            "roster": [],
            "archived": []
          }
        },
        {
          "name": "no match",
          "input": {
            "people": [
              {
                "person_id": 1,
                "display_name": "Aoife Kelly",
                "attending": false,
                "archived": false
              },
              {
                "person_id": 2,
                "display_name": "Brian Kelly",
                "attending": true,
                "archived": false
              },
              {
                "person_id": 3,
                "display_name": "Maura Nolan",
                "attending": true,
                "archived": true
              },
              {
                "person_id": 4,
                "display_name": "Seán Kelly",
                "attending": false,
                "archived": true
              },
              {
                "person_id": 5,
                "display_name": "Tom Byrne",
                "attending": false,
                "archived": false
              }
            ],
            "query": "zz"
          },
          "expected": {
            "here": [],
            "roster": [],
            "archived": []
          }
        },
        {
          "name": "no people",
          "input": {
            "people": null,
            "query": ""
          },
          "expected": {
            "here": [],
            "roster": [],
            "archived": []
          }
        }
      ]
    },
    "splitName": {
      "params": [
        "query"
      ],
      "cases": [
        {
          "name": "first and the rest",
          "input": {
            "query": "  Mary Kate  Quinn "
          },
          "expected": {
            "first": "Mary",
            "last": "Kate Quinn"
          }
        },
        {
          "name": "one name",
          "input": {
            "query": "Cher"
          },
          "expected": {
            "first": "Cher",
            "last": ""
          }
        },
        {
          "name": "nothing",
          "input": {
            "query": ""
          },
          "expected": {
            "first": "",
            "last": ""
          }
        }
      ]
    },
    "remoteLabel": {
      "params": [
        "d"
      ],
      "cases": [
        {
          "name": "a tune added",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            }
          },
          "expected": "added The Kesh"
        },
        {
          "name": "one with no name, by its id",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "tune_id": 7
              }
            }
          },
          "expected": "added #7"
        },
        {
          "name": "one with neither",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {}
            }
          },
          "expected": "added a tune"
        },
        {
          "name": "merged into an existing row",
          "input": {
            "d": {
              "op_type": "corroborate",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            }
          },
          "expected": "also logged The Kesh"
        },
        {
          "name": "edited",
          "input": {
            "d": {
              "op_type": "change_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            }
          },
          "expected": "edited The Kesh"
        },
        {
          "name": "removed",
          "input": {
            "d": {
              "op_type": "remove_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            }
          },
          "expected": "removed The Kesh"
        },
        {
          "name": "moved, one",
          "input": {
            "d": {
              "op_type": "move_tunes",
              "moved_ids": [
                1
              ]
            }
          },
          "expected": "moved 1 tune"
        },
        {
          "name": "moved, several",
          "input": {
            "d": {
              "op_type": "move_tunes",
              "moved_ids": [
                1,
                2,
                3
              ]
            }
          },
          "expected": "moved 3 tunes"
        },
        {
          "name": "bulk removed",
          "input": {
            "d": {
              "op_type": "remove_tunes",
              "records": [
                {
                  "session_instance_tune_id": 9,
                  "name": "The Kesh",
                  "tune_id": 55
                },
                {
                  "session_instance_tune_id": 9,
                  "name": "The Kesh",
                  "tune_id": 55
                }
              ]
            }
          },
          "expected": "removed 2 tunes"
        },
        {
          "name": "restored",
          "input": {
            "d": {
              "op_type": "restore_tunes",
              "records": [
                {
                  "session_instance_tune_id": 9,
                  "name": "The Kesh",
                  "tune_id": 55
                }
              ]
            }
          },
          "expected": "restored 1 tune"
        },
        {
          "name": "a set ended",
          "input": {
            "d": {
              "op_type": "set_break",
              "record": {}
            }
          },
          "expected": "ended a set"
        },
        {
          "name": "a break removed",
          "input": {
            "d": {
              "op_type": "set_break",
              "removed": true
            }
          },
          "expected": "removed a break"
        },
        {
          "name": "a starter set",
          "input": {
            "d": {
              "op_type": "attribute_set_starter",
              "person": {
                "display_name": "Sarah O'Connor"
              }
            }
          },
          "expected": "set Sarah O'Connor as starting a set"
        },
        {
          "name": "a starter cleared",
          "input": {
            "d": {
              "op_type": "attribute_set_starter",
              "person": null
            }
          },
          "expected": "cleared a set starter"
        },
        {
          "name": "confirmed",
          "input": {
            "d": {
              "op_type": "set_confidence",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            }
          },
          "expected": "confirmed The Kesh"
        },
        {
          "name": "checked in",
          "input": {
            "d": {
              "op_type": "attendance_add",
              "person": {
                "display_name": "Brian Kelly"
              }
            }
          },
          "expected": "checked in Brian Kelly"
        },
        {
          "name": "someone new",
          "input": {
            "d": {
              "op_type": "attendance_create_person",
              "person": {
                "display_name": "Zed Tester"
              }
            }
          },
          "expected": "added Zed Tester"
        },
        {
          "name": "checked out",
          "input": {
            "d": {
              "op_type": "attendance_remove",
              "person": {
                "display_name": "Brian Kelly"
              }
            }
          },
          "expected": "checked out Brian Kelly"
        },
        {
          "name": "attendance with no person",
          "input": {
            "d": {
              "op_type": "attendance_add"
            }
          },
          "expected": "updated attendance"
        },
        {
          "name": "notes",
          "input": {
            "d": {
              "op_type": "edit_notes"
            }
          },
          "expected": "edited the notes"
        },
        {
          "name": "re-dated and re-timed",
          "input": {
            "d": {
              "op_type": "set_date",
              "date": "2026-09-30",
              "previous_date": "2026-09-29",
              "session_date": "Wed Sep 30",
              "start_time": "19:00",
              "previous_start_time": "20:00",
              "end_time": "22:00",
              "previous_end_time": "22:00"
            }
          },
          "expected": "re-dated this log to Wed Sep 30, 7:00pm-10:00pm"
        },
        {
          "name": "re-dated only",
          "input": {
            "d": {
              "op_type": "set_date",
              "date": "2026-09-30",
              "previous_date": "2026-09-29",
              "session_date": "Wed Sep 30"
            }
          },
          "expected": "re-dated this log to Wed Sep 30"
        },
        {
          "name": "re-dated, no display date",
          "input": {
            "d": {
              "op_type": "set_date",
              "date": "2026-09-30",
              "previous_date": "2026-09-29"
            }
          },
          "expected": "re-dated this log"
        },
        {
          "name": "a new time",
          "input": {
            "d": {
              "op_type": "set_date",
              "date": "2026-09-29",
              "previous_date": "2026-09-29",
              "start_time": "19:30",
              "previous_start_time": "19:00"
            }
          },
          "expected": "set this log's time to 7:30pm - ?"
        },
        {
          "name": "an open-ended time",
          "input": {
            "d": {
              "op_type": "set_date",
              "start_time": "21:30",
              "previous_start_time": "21:00",
              "end_time": null,
              "previous_end_time": "23:00"
            }
          },
          "expected": "set this log's time to 9:30pm - ?"
        },
        {
          "name": "the time cleared",
          "input": {
            "d": {
              "op_type": "set_date",
              "start_time": null,
              "previous_start_time": "19:00"
            }
          },
          "expected": "cleared this log's time"
        },
        {
          "name": "nothing actually moved",
          "input": {
            "d": {
              "op_type": "set_date",
              "date": "2026-09-29",
              "previous_date": "2026-09-29"
            }
          },
          "expected": "re-dated this log"
        },
        {
          "name": "named",
          "input": {
            "d": {
              "op_type": "set_name",
              "instance_name": "Céilí night"
            }
          },
          "expected": "named this log \"Céilí night\""
        },
        {
          "name": "name cleared",
          "input": {
            "d": {
              "op_type": "set_name",
              "instance_name": ""
            }
          },
          "expected": "cleared this log's name"
        },
        {
          "name": "something else",
          "input": {
            "d": {
              "op_type": "mark_complete"
            }
          },
          "expected": null
        }
      ]
    },
    "activityText": {
      "params": [
        "d",
        "myPersonId",
        "viewing"
      ],
      "cases": [
        {
          "name": "someone else, while I edit",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              },
              "actor": {
                "person_id": 5,
                "name": "Sarah O'Connor"
              }
            },
            "myPersonId": 1,
            "viewing": false
          },
          "expected": "Sarah O'Connor added The Kesh"
        },
        {
          "name": "me, while I edit: nothing",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              },
              "actor": {
                "person_id": 1,
                "name": "Ian Varley"
              }
            },
            "myPersonId": 1,
            "viewing": false
          },
          "expected": null
        },
        {
          "name": "me, from another window, while I watch",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              },
              "actor": {
                "person_id": 1,
                "name": "Ian Varley"
              }
            },
            "myPersonId": 1,
            "viewing": true
          },
          "expected": "Ian Varley added The Kesh"
        },
        {
          "name": "no actor: nothing",
          "input": {
            "d": {
              "op_type": "add_tune",
              "record": {
                "session_instance_tune_id": 9,
                "name": "The Kesh",
                "tune_id": 55
              }
            },
            "myPersonId": 1,
            "viewing": true
          },
          "expected": null
        },
        {
          "name": "a nameless actor",
          "input": {
            "d": {
              "op_type": "edit_notes",
              "actor": {
                "person_id": 5
              }
            },
            "myPersonId": 1,
