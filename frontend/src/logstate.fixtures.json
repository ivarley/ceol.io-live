          "input": {
            "insertAfterId": { "newSet": 3 },
            "segments": [
              { "tunes": [{ "session_instance_tune_id": 1 }], "breakAfter": null },
              { "tunes": [{ "session_instance_tune_id": 3 }], "breakAfter": null }
            ]
          },
          "expected": null
        },
        {
          "name": "start seams have no action",
          "input": {
            "insertAfterId": { "before": 1 },
            "segments": [{ "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": null }]
          },
          "expected": null
        },
        {
          "name": "the end has no action",
          "input": {
            "insertAfterId": null,
            "segments": [{ "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": null }]
          },
          "expected": null
        },
        {
          "name": "a temp (string) id never splits",
          "input": {
            "insertAfterId": "temp-1",
            "segments": [{ "tunes": [{ "session_instance_tune_id": "temp-1", "_temp": true }, { "session_instance_tune_id": 2 }], "breakAfter": null }]
          },
          "expected": null
        },
        {
          "name": "an id not in any set",
          "input": {
            "insertAfterId": 99,
            "segments": [{ "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": null }]
          },
          "expected": null
        }
      ]
    },

