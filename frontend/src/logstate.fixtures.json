    "computeCursorSlots": {
      "params": ["segments", "endIsOpen", "hasOrdered"],
      "cases": [
        {
          "name": "start seams, after-tune seams and between-set seams; the open set's last seam IS the end",
          "input": {
            "segments": [
              { "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": 100 },
              { "tunes": [{ "session_instance_tune_id": 3 }], "breakAfter": 101 },
              { "tunes": [{ "session_instance_tune_id": 4 }], "breakAfter": null }
            ],
            "endIsOpen": true,
            "hasOrdered": true
          },
          "expected": [{ "before": 1 }, 1, 2, { "newSet": 3 }, { "before": 3 }, 3, { "newSet": 4 }, { "before": 4 }, null]
        },
        {
          "name": "log ends on a break: one trailing closed-end null",
          "input": {
            "segments": [
              { "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": 100 },
              { "tunes": [{ "session_instance_tune_id": 3 }], "breakAfter": 101 }
            ],
            "endIsOpen": false,
            "hasOrdered": true
          },
          "expected": [{ "before": 1 }, 1, 2, { "newSet": 3 }, { "before": 3 }, 3, null]
        },
        {
          "name": "temp rows contribute no after-seam; a temp last tune leaves no end slot",
          "input": {
            "segments": [{ "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": "temp-2", "_temp": true }], "breakAfter": null }],
            "endIsOpen": true,
            "hasOrdered": true
          },
          "expected": [{ "before": 1 }, 1]
        },
        {
          "name": "a set whose FIRST tune is temp still gets a start seam keyed on the temp id",
          "input": {
            "segments": [{ "tunes": [{ "session_instance_tune_id": "temp-1", "_temp": true }, { "session_instance_tune_id": 2 }], "breakAfter": 9 }],
            "endIsOpen": false,
            "hasOrdered": true
          },
          "expected": [{ "before": "temp-1" }, 2, null],
          "note": "The start seam ignores _temp, unlike the after-tune seams. Pinned as it stands."
        },
        {
          "name": "no between-set seam when the segment has no closing break",
          "input": {
            "segments": [
              { "tunes": [{ "session_instance_tune_id": 1 }], "breakAfter": null },
              { "tunes": [{ "session_instance_tune_id": 2 }], "breakAfter": null }
            ],
            "endIsOpen": true,
            "hasOrdered": true
          },
          "expected": [{ "before": 1 }, 1, { "before": 2 }, null]
        },
        {
          "name": "only breaks in the log: just the closed-end seam",
          "input": { "segments": [], "endIsOpen": false, "hasOrdered": true },
          "expected": [null]
        },
        { "name": "empty log", "input": { "segments": [], "endIsOpen": false, "hasOrdered": false }, "expected": [] }
      ]
    },

    "seamKeyFor": {
      "params": ["s"],
      "cases": [
        { "name": "null is the end", "input": { "s": null }, "expected": "end" },
        { "name": "absent is the end", "input": {}, "expected": "end" },
        { "name": "a tune id", "input": { "s": 42 }, "expected": "after:42" },
        { "name": "id 0 is an id, not the end", "input": { "s": 0 }, "expected": "after:0" },
        { "name": "a temp id", "input": { "s": "temp-x" }, "expected": "after:temp-x" },
        { "name": "start seam", "input": { "s": { "before": 7 } }, "expected": "start:7" },
        { "name": "between-set seam", "input": { "s": { "newSet": 9 } }, "expected": "inter:9" },
        { "name": "newSet is checked before before", "input": { "s": { "newSet": 9, "before": 7 } }, "expected": "inter:9" }
      ]
    },

