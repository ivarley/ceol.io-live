              { "tunes": [{ "session_instance_tune_id": 1 }, { "session_instance_tune_id": 2 }], "breakAfter": 100 },
              { "tunes": [{ "session_instance_tune_id": 3 }], "breakAfter": 101 },
              { "tunes": [{ "session_instance_tune_id": 4 }], "breakAfter": null }
            ]
          },
          "expected": { "type": "join", "breakId": 101 }
        },
        {
