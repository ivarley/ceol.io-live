    "historyStep": {
      "params": ["hist", "pos", "dir"],
      "cases": [
        { "name": "Up from the draft lands on the newest", "input": { "hist": ["reel", "jig", "polka"], "pos": null, "dir": -1 }, "expected": { "pos": 2, "value": "polka" } },
        { "name": "Up walks older", "input": { "hist": ["reel", "jig", "polka"], "pos": 2, "dir": -1 }, "expected": { "pos": 1, "value": "jig" } },
        { "name": "Up clamps at the oldest", "input": { "hist": ["reel", "jig", "polka"], "pos": 0, "dir": -1 }, "expected": { "pos": 0, "value": "reel" } },
        { "name": "Down walks newer", "input": { "hist": ["reel", "jig", "polka"], "pos": 0, "dir": 1 }, "expected": { "pos": 1, "value": "jig" } },
        { "name": "Down past the newest returns to an empty draft", "input": { "hist": ["reel", "jig", "polka"], "pos": 2, "dir": 1 }, "expected": { "pos": null, "value": "" } },
        { "name": "Down from the draft is not possible", "input": { "hist": ["reel", "jig", "polka"], "pos": null, "dir": 1 }, "expected": null },
        { "name": "only the sign of dir matters", "input": { "hist": ["reel", "jig", "polka"], "pos": null, "dir": -5 }, "expected": { "pos": 2, "value": "polka" } },
        { "name": "dir 0 behaves as Down (from a position)", "input": { "hist": ["reel", "jig"], "pos": 0, "dir": 0 }, "expected": { "pos": 1, "value": "jig" } },
        { "name": "dir 0 behaves as Down (from the draft)", "input": { "hist": ["reel", "jig"], "pos": null, "dir": 0 }, "expected": null },
        { "name": "empty history never steps (Up)", "input": { "hist": [], "pos": null, "dir": -1 }, "expected": null },
        { "name": "empty history never steps (Down)", "input": { "hist": [], "pos": null, "dir": 1 }, "expected": null }
      ]
    }
  }
}
