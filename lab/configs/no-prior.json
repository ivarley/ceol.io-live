    {"name": "boundary_novelty", "params": {"threshold": 0.55}},
    {"name": "pitch_pyin"},
    {"name": "pitch_yin"},
    {"name": "notes", "params": {"sources": ["pitch_pyin"]}},
    {"name": "intervals", "params": {"window_notes": 48}},
