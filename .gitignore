# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# anchored: the Python-template `lib/` was swallowing frontend/src/lib (the spec-035 kit)
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
TEST_OUTPUT.txt
test-results.xml

# Playwright e2e
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
.playwright/

# Translations
*.mo
# Spec 057: the compiled Irish catalog is committed (the deploy build may not run
# pybabel compile); tests/unit/test_i18n_catalogs.py checks it matches the .po.
!translations/**/*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Environment variables
.env
.env.test

# Database backups and other local data, including sensitive production data.
# Anchored: an unanchored "data/" matches a directory named data at ANY depth,
# which silently swallowed specs/current/data/ (backups only ever land in
# /data/backup/ — see scripts/DATABASE_BACKUP.md).
/data/

# Claude
.claude-code-config.json

# Node.js dependencies
node_modules/
package-lock.json

# TypeScript/Webpack build outputs
static/js/dist/
static/js/shared/
design/*
# ...except the design tokens, the one source both clients' tokens are generated
# from (spec 052 §B6). Ignored along with the rest, they existed on one disk only.
!design/tokens.json
!design/Tokens.swift

# Live-logging Svelte/Vite build output (spec 024) -- built during deploy
static/live/

# Add-to-My-Tunes pane build output -- built during deploy (frontend npm run build)
static/mytunes/

# Spec 035 page-bundle build outputs -- all built during deploy (frontend npm run build)
static/mytunespage/
static/sessionsdir/
static/sessionpage/
static/personpage/
static/sessionadminpage/
static/festivalpage/
static/placesadminpage/
static/tunesheet/
static/peopleadminpage/
static/segmenterpage/
static/homepage/

# Claude Code worktrees (each contains its own checkout)
.claude/worktrees/

# ./start writes the streaming sidecar's output here
logs/

# iOS (spec 052): per-user Xcode state and SwiftPM build output. The package
# lockfiles (ios/CeolKit/Package.resolved, and Xcode's copy under xcshareddata) ARE
# committed, so everyone builds against the same generator and runtime.
ios/**/xcuserdata/
ios/CeolKit/.build/
ios/CeolKit/.swiftpm/

# iOS build output from `make ios-test` / `make ios-build`
ios/.derived/
ios/.derived-release/
# a debug build for a phone, installed with devicectl
ios/.derived-device/

# Ceol Listen lab (spec 053): pulled masters, derived wavs, features, the
# SQLite board, indexes and run output. Anchored for the same reason /data/ is.
/lab/data/

# The lab's own environment file: production database URL and AWS keys, which
# the app's .env deliberately does not hold. The unanchored `.env` rule above
# already catches this, but it is named explicitly because these are live
# credentials and a later tidy-up that anchors that rule must not silently
# start tracking them.
/lab/.env
